<section class="mx-auto w-full max-w-2xl">
  <h1 class="text-2xl font-semibold">Organizations</h1>
  <p class="mt-1 text-sm text-gray-600">
    Workspaces you belong to. The current one scopes everything you do in the app.
  </p>

  <ul class="mt-6 divide-y divide-gray-200">
    <% @memberships.each do |membership| %>
      <% organization = membership.organization %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-4">
        <div>
          <span class="font-medium"><%= organization.name %></span>
          <span class="ml-2 text-sm text-gray-600"><%= membership.role %></span>
          <% if organization == current_organization %>
            <span class="ml-2 rounded bg-gray-100 px-2 py-0.5 text-xs uppercase tracking-wide">current</span>
          <% end %>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <% if organization == current_organization %>
            <%= link_to "Members", memberships_path, class: "underline underline-offset-2 hover:text-gray-600" %>
          <% else %>
            <%= button_to "Switch", switch_organization_path(organization),
                  class: "underline underline-offset-2 hover:text-gray-600" %>
          <% end %>
          <% if current_user.is_admin_of?(organization) %>
            <%= link_to "Settings", edit_organization_path(organization),
                  class: "underline underline-offset-2 hover:text-gray-600" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <%= link_to "New organization", new_organization_path,
        class: "mt-6 inline-block rounded-md bg-gray-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-gray-700" %>
</section>
