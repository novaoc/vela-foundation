<section class="mx-auto w-full max-w-md">
  <h1 class="text-2xl font-semibold">Organization settings</h1>

  <% if @organization.errors.any? %>
    <div role="alert" class="mt-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">
      <ul>
        <% @organization.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @organization, url: organization_path(@organization), method: :patch, class: "mt-6 space-y-5" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium" %>
      <%= f.text_field :name, required: true,
            class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>
    <%= f.submit "Rename organization",
          class: "w-full rounded-md bg-gray-900 px-4 py-2.5 font-medium text-white hover:bg-gray-700" %>
  <% end %>

  <p class="mt-6 text-sm">
    <% if @organization == current_organization %>
      <%= link_to "Members", memberships_path, class: "underline underline-offset-2 hover:text-gray-600" %> ·
    <% end %>
    <%= link_to "All organizations", organizations_path, class: "underline underline-offset-2 hover:text-gray-600" %>
  </p>

  <% if current_user.is_owner_of?(@organization) %>
    <h2 class="mt-10 text-lg font-semibold">Delete organization</h2>
    <p class="mt-1 text-sm text-gray-600">
      Permanently removes <%= @organization.name %>, its memberships, and its pending invitations.
    </p>
    <%= button_to "Delete organization", organization_path(@organization), method: :delete,
          form: { data: { turbo_confirm: "Delete #{@organization.name}? This cannot be undone." } },
          class: "mt-3 rounded-md border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50" %>
  <% end %>
</section>
