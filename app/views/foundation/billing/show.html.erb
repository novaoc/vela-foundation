<% title "Billing" %>

<section class="md-page md-page--narrow md-stack">
  <header>
    <p class="md-section__eyebrow">Workspace settings</p>
    <h1>Billing</h1>
    <p class="text-md-on-surface-variant">Subscription and plan settings for <strong><%= @organization.name %></strong>.</p>
  </header>

  <article class="md-card md-card--elevated md-stack">
    <div>
      <p class="text-md-on-surface-variant">Current plan</p>
      <h2><%= @plan.name %></h2>
    </div>
    <% if @source == :assignment %>
      <span class="md-chip selected">Manually assigned</span>
    <% elsif @source == :subscription %>
      <span class="md-chip selected">Stripe subscription</span>
    <% else %>
      <span class="md-chip">Free plan</span>
    <% end %>

    <div class="md-actions">
      <% if @organization.billing_management_available? %>
        <%= button_to "Manage subscription", billing_portal_path, data: { turbo: false }, class: "md-button md-button--filled" %>
      <% end %>
      <% if @organization.show_self_serve_plan_ctas? %>
        <%= link_to "Compare plans", pricing_path, class: "md-button md-button--outlined" %>
      <% end %>
    </div>

    <% if @source == :assignment && @organization.billing_management_available? %>
      <p class="text-md-on-surface-variant">Your administrator controls feature access. The billing portal remains available for the separate live subscription.</p>
    <% end %>
  </article>
</section>
