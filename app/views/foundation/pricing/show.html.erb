<% title "Pricing" %>

<section class="md-page">
  <header class="text-center">
    <p class="md-section__eyebrow">Plans</p>
    <h1>Plans for every stage</h1>
    <p class="text-md-on-surface-variant">Choose monthly flexibility or save with annual billing.</p>
    <%= render "foundation/components/tabs", label: "Billing interval", tabs: %w[month year].map { |interval|
      { label: interval == "month" ? "Monthly" : "Yearly", href: pricing_path(interval: interval), active: @interval == interval }
    } %>
  </header>

  <% if @organization&.manually_assigned_plan? %>
    <div class="md-card md-card--filled mt-8" role="status">
      <strong>Manually assigned plan.</strong> Contact an administrator to change access. Existing subscription billing can still be managed from <%= link_to "Billing", billing_path %>.
    </div>
  <% end %>

  <div class="md-pricing-grid">
    <% @plans.each do |plan| %>
      <% current = @organization && plan == @organization.current_pricing_plan %>
      <% cents = plan.metadata.dig(:prices, @interval.to_sym) %>
      <article class="md-card <%= plan.highlighted? ? "md-card--elevated" : "md-card--outlined" %> md-price-card">
        <% if plan.highlighted? %><span class="md-chip selected">Most popular</span><% end %>
        <h2><%= plan.name %></h2>
        <p class="text-md-on-surface-variant"><%= plan.description %></p>
        <p class="md-price-card__price">
          <%= cents.zero? ? "Free" : number_to_currency(cents / 100.0, precision: 0) %>
          <% unless cents.zero? %><span class="text-md-on-surface-variant">/<%= @interval %></span><% end %>
        </p>
        <ul><% plan.bullets.each do |bullet| %><li><%= bullet %></li><% end %></ul>

        <% if current %>
          <span class="md-chip selected">Current plan<%= " · manual" if @organization.manually_assigned_plan? %></span>
        <% elsif @organization&.manually_assigned_plan? %>
          <span class="md-chip">Administrator managed</span>
        <% elsif cents.zero? %>
          <%= link_to "Get started", user_signed_in? ? billing_path : new_user_registration_path, class: "md-button md-button--outlined" %>
        <% elsif user_signed_in? %>
          <%= button_to "Choose #{plan.name}", billing_checkout_path,
                params: { plan: plan.key, interval: @interval }, data: { turbo: false },
                class: "md-button md-button--filled" %>
        <% else %>
          <%= link_to "Sign in to subscribe", new_user_session_path, class: "md-button md-button--filled" %>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
