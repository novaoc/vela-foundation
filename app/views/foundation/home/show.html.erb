<%# Minimal landing page; the M7 marketing set replaces this. %>
<section class="mx-auto max-w-xl text-center">
  <h1 class="text-3xl font-semibold"><%= Rails.configuration.x.foundation[:application_name] %></h1>
  <p class="mt-4 text-gray-600"><%= Rails.configuration.x.foundation[:default_page_description] %></p>

  <% unless user_signed_in? %>
    <div class="mt-8 flex justify-center gap-4">
      <%= link_to "Create an account", new_user_registration_path,
            class: "rounded-md bg-gray-900 px-4 py-2.5 font-medium text-white hover:bg-gray-700" %>
      <%= link_to "Sign in", new_user_session_path,
            class: "rounded-md border border-gray-300 px-4 py-2.5 font-medium hover:bg-gray-50" %>
    </div>
  <% end %>
</section>
